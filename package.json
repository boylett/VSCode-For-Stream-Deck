{
  "name": "dev.boylett.vscode",
  "version": "7.0.0",
  "description": "Bridges Visual Studio Code to Stream Deck, allowing you to execute commands, run terminal commands, insert snippets and more directly from your Stream Deck.",
  "type": "module",
  "scripts": {
    "build": "rollup --config rollup.config.mjs",
    "watch": "rollup --config rollup.config.mjs --watch",
    "install-plugin": "node scripts/install-plugin.mjs"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.0.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.13",
    "rollup": "^4.32.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3"
  }
}
